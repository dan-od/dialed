# Dialed — environment keys. Names and purpose only. Never commit real values.
# Copy to .env (0600) on the home lab. Local dev works without any external credentials (see *_MODE keys).

# --- core ---
NODE_ENV=                     # development | test | production
APP_NAME=Dialed               # single source for the product name (may change)
PUBLIC_BASE_URL=              # https://api.okoro.me — used for links, OAuth issuer, MCP URL
PORT=                         # API listen port inside the container (e.g. 8080)
LOG_LEVEL=                    # info | debug
SIGNUP_MODE=                  # invite | open  (default invite, D-16)
APPLE_TEAM_TIER=              # personal | paid — personal = free Apple account: no APNs, no Sign in with Apple, no universal links (BACKEND_SETUP §13)

# --- database ---
DATABASE_URL=                 # postgres://dialed:...@postgres:5432/dialed
POSTGRES_PASSWORD=            # used by the postgres container only

# --- auth ---
JWT_PRIVATE_KEY_FILE=         # path to Ed25519 private key (PEM) for access tokens
JWT_KEY_ID=                   # kid of the active key; keep previous key file for rotation
CODE_PEPPER=                  # random 32 bytes, hex; peppers email-code and token hashes
APPLE_TEAM_ID=                # Apple Developer team ID
APPLE_BUNDLE_ID=              # me.okoro.dialed (audience for Sign in with Apple)
APPLE_KEY_ID=                 # Sign in with Apple key ID (for client secret / revoke)
APPLE_PRIVATE_KEY_FILE=       # path to Sign in with Apple .p8
APPLE_TOKEN_ENC_KEY=          # 32 bytes hex; encrypts stored Apple refresh tokens (revoke on delete)

# --- email ---
EMAIL_TRANSPORT=              # smtp | console (console prints codes to the log in dev)
SMTP_URL=                     # smtp(s)://user:pass@host:port (e.g. Resend SMTP)
EMAIL_FROM=                   # "Dialed <no-reply@okoro.me>"

# --- push (APNs) ---
APNS_MODE=                    # apns | log (log in dev/simulator)
APNS_KEY_ID=                  # APNs auth key ID
APNS_TEAM_ID=                 # Apple team ID
APNS_PRIVATE_KEY_FILE=        # path to APNs .p8
APNS_TOPIC=                   # bundle ID (alerts); Live Activity topic = <bundle>.push-type.liveactivity
APNS_ENV=                     # sandbox | production

# --- AI ---
AI_MODE=                      # live | fixture (fixture = deterministic recorded plans for tests/dev)
ANTHROPIC_API_KEY=            # Dialed server key (owner pays); used when a user picks "Dialed server"
PLAN_MODEL_ANTHROPIC=         # model id for planning + vision (set from Anthropic console; not hard-coded)
PLAN_MODEL_OPENAI=            # default model id when a user brings an OpenAI key
PLAN_MODEL_GEMINI=            # default model id when a user brings a Gemini key
PLAN_MAX_TOKENS=              # per-plan output token ceiling
PLAN_DAILY_LIMIT=             # server-key plan runs per user per day (default 30)
IMPORT_DAILY_LIMIT=           # server-key timetable imports per user per day (default 6)
ALLOW_PRIVATE_PROVIDER_URLS=  # true only to allow an OpenAI-compatible model on the owner's LAN
UPLOAD_DIR=                   # tmp dir for timetable uploads (0700), swept hourly

# --- MCP / OAuth ---
MCP_ENABLED=                  # true | false
OAUTH_ACCESS_TTL_SECONDS=     # default 3600
OAUTH_REFRESH_TTL_DAYS=       # default 30

# --- ops ---
ADMIN_TOKEN=                  # bearer for /admin/* on the internal network only
CLOUDFLARE_TUNNEL_TOKEN=      # cloudflared connector token (compose service only)
BACKUP_DIR=                   # NAS path for nightly pg_dump files

# --- verification (CI/dev only) ---
FLOW_BY_FLOW_REPORT_DIR=      # directory where scripts/auth_smoke writes authorization.json (e.g. evidence/verification)

# Mobile (Metro inlines EXPO_PUBLIC_* when it bundles): D-35 screens awaiting owner approval stay off.
# Start Metro with EXPO_PUBLIC_FEATURE_D35=true to see them in a dev build.
EXPO_PUBLIC_FEATURE_D35=false
