#!/usr/bin/env bash
# Builds and installs the iOS dev client on a Simulator, then serves JS with Metro (file watching on).
# Usage: ./scripts/ios_dev [simulator-name-or-udid]   (default: iPhone 17e, 390×844 like the prototype frame)
# The repo must not live in an iCloud-synced folder: File Provider tags .framework bundles and codesign refuses them.
source "$(dirname "$0")/lib/common.sh"
ensure_node
ensure_xcode_env
export LANG=en_US.UTF-8
DEVICE="${1:-iPhone 17e}"
case "$ROOT" in "$HOME/Documents"*|"$HOME/Desktop"*) log "Warning: $ROOT may be iCloud-synced; codesign can fail there." ;; esac
cd "$ROOT/apps/mobile"
CI=1 npx expo prebuild --platform ios --clean >/dev/null
npx expo run:ios --device "$DEVICE" --no-bundler
log "Starting Metro (Ctrl-C to stop)"
exec npx expo start --dev-client --port 8081
