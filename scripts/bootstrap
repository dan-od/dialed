#!/usr/bin/env bash
# Idempotent local setup: tools → .env + dev key → deps → Postgres (compose) → migrate → seed.
# A second run must change nothing: compare state_before/state_after in the final JSON line.
source "$(dirname "$0")/lib/common.sh"
ensure_node

log "Checking tools"
command -v pnpm >/dev/null || die "pnpm is required (corepack enable)."
command -v docker >/dev/null || die "Docker is required (Docker Desktop or OrbStack)."
docker info >/dev/null 2>&1 || die "Docker daemon is not running."
log "node $(node --version) · pnpm $(pnpm --version) · $(docker --version | cut -d, -f1) ($(docker info --format '{{.OperatingSystem}}'))"

created=()
if [[ ! -f .env ]]; then
  log "Writing .env (dev values, 0600)"
  umask 077
  cat > .env <<ENV
# Local development — generated by scripts/bootstrap. Never commit. No real credentials here.
NODE_ENV=development
APP_NAME=Dialed
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info
SIGNUP_MODE=invite
APPLE_TEAM_TIER=personal
POSTGRES_PASSWORD=$(openssl rand -hex 16)
JWT_PRIVATE_KEY_FILE=$ROOT/.secrets/jwt-ed25519.pem
JWT_KEY_ID=dev-1
CODE_PEPPER=$(openssl rand -hex 32)
EMAIL_TRANSPORT=console
EMAIL_FROM="Dialed <no-reply@okoro.me>"
APNS_MODE=log
AI_MODE=fixture
MCP_ENABLED=false
FLOW_BY_FLOW_REPORT_DIR=evidence/verification
ENV
  # DATABASE_URL uses the generated password.
  pw=$(grep '^POSTGRES_PASSWORD=' .env | cut -d= -f2)
  echo "DATABASE_URL=postgres://dialed:${pw}@127.0.0.1:55432/dialed" >> .env
  chmod 600 .env
  created+=(".env")
fi
if [[ ! -f .secrets/jwt-ed25519.pem ]]; then
  log "Generating dev JWT signing key (.secrets/, git-ignored)"
  mkdir -p .secrets && chmod 700 .secrets
  node -e 'const {generateKeyPairSync}=require("node:crypto");const fs=require("node:fs");
    const {privateKey}=generateKeyPairSync("ed25519");
    fs.writeFileSync(".secrets/jwt-ed25519.pem", privateKey.export({type:"pkcs8",format:"pem"}), {mode:0o600});'
  created+=(".secrets/jwt-ed25519.pem")
fi
load_env

log "Installing dependencies (frozen lockfile)"
pnpm install --frozen-lockfile --reporter=silent

log "Starting Postgres 16 (compose, 127.0.0.1:55432)"
compose up -d postgres >/dev/null 2>&1 || compose up -d postgres
wait_for_postgres

state() { tsx apps/api/src/cli/state.ts; }
before=$(state)
log "Migrating"
migrate_out=$(./scripts/migrate)
log "Seeding (owner, alice, bob; dev password hashed with argon2id)"
seed_out=$(tsx apps/api/src/cli/seed.ts)
after=$(state)

node -e '
const [created, mig, seed, before, after] = process.argv.slice(1);
const b = JSON.parse(before), a = JSON.parse(after);
console.log(JSON.stringify({ ok: true, created_files: created ? created.split(" ") : [], migrate: JSON.parse(mig), seed: JSON.parse(seed),
  state_before: b.digest, state_after: a.digest, changed: b.digest !== a.digest, schema_fingerprint: a.fingerprint }));
' "${created[*]:-}" "$migrate_out" "$seed_out" "$before" "$after"
