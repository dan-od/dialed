#!/usr/bin/env bash
# Dev only: removes what Flow 04 evidence creates (category "Bible study", blocks "Capstone reading" and
# "Prayers, login flow", and skip/modify/move overrides left by an aborted run; the owner has no real ones yet) from the owner's local data, the
# same way the server writes (revision bump + change_log), so the phone syncs the removal. Refuses any
# database that isn't the local compose Postgres.
source "$(dirname "$0")/lib/common.sh"
set -a; source "$ROOT/.env"; set +a
[[ "$NODE_ENV" == development && "$DATABASE_URL" == *"@127.0.0.1:55432/"* ]] || die "Not the local dev database."
OWNER=c5610ac2-5ae9-57cd-9cd6-a9e11adb97a6
# The owner's seed rows of one table, inserted into a temp table instead.
seed_rows() {
  grep "^INSERT INTO $1(" "$ROOT/backend/seed/0001_seed.sql" | grep "'$OWNER'" \
    | sed -e "s/^INSERT INTO $1(/INSERT INTO $2(/" -e 's/ ON CONFLICT (id) DO NOTHING;$/;/'
}
docker compose -f "$ROOT/infra/docker-compose.yml" exec -T postgres psql -U dialed -d dialed -v ON_ERROR_STOP=1 -q <<SQL
BEGIN;
WITH gone AS (
  UPDATE categories SET deleted_at = now(), version = version + 1
  WHERE user_id = '$OWNER' AND lower(name) = 'bible study' AND deleted_at IS NULL RETURNING *
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now() WHERE EXISTS (SELECT 1 FROM gone)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, 'category', gone.id, 'upsert', to_jsonb(gone) - 'user_id' FROM gone, rev;
WITH gone AS (
  UPDATE routine_blocks SET deleted_at = now(), version = version + 1
  WHERE user_id = '$OWNER' AND source = 'user' AND title IN ('Capstone reading', 'Prayers, login flow', 'Read Acts 2', 'Read', 'Pitch prep')
    AND deleted_at IS NULL RETURNING *
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now() WHERE EXISTS (SELECT 1 FROM gone)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, 'routine_block', gone.id, 'upsert', to_jsonb(gone) - 'user_id' FROM gone, rev;
WITH gone AS (
  UPDATE overrides SET deleted_at = now(), version = version + 1
  WHERE user_id = '$OWNER' AND source = 'user' AND deleted_at IS NULL
    AND (title IN ('Capstone reading', 'Prayers, login flow', 'Read Acts 2', 'Read', 'Pitch prep')
         OR (kind IN ('skip', 'modify', 'move') AND note IS NULL)) -- seed overrides carry a note (Thanksgiving)
  RETURNING *
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now() WHERE EXISTS (SELECT 1 FROM gone)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, 'override', gone.id, 'upsert', to_jsonb(gone) - 'user_id' FROM gone, rev;
-- Every-week edits and routine saves made by evidence runs (Flow 04 rename/move, Flow 05 Save routine): drop
-- user versions starting today or later and reopen the seed versions they closed, so the routine is the seed.
WITH gone AS (
  UPDATE routine_blocks SET deleted_at = now(), version = version + 1
  WHERE user_id = '$OWNER' AND source = 'user' AND deleted_at IS NULL AND effective_from >= current_date
  RETURNING *
), reopened AS (
  UPDATE routine_blocks SET effective_to = NULL, version = version + 1
  WHERE user_id = '$OWNER' AND source = 'seed' AND deleted_at IS NULL AND effective_to IS NOT NULL
  RETURNING *  -- the seed has no ended blocks; any end date on one comes from a test
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now()
  WHERE EXISTS (SELECT 1 FROM gone) OR EXISTS (SELECT 1 FROM reopened)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, 'routine_block', x.id, 'upsert', to_jsonb(x) - 'user_id'
FROM rev, (SELECT * FROM gone UNION ALL SELECT * FROM reopened) x;
-- Terms created by the Flow 05 "Name your term" evidence (feature-flagged sheet).
WITH gone AS (
  UPDATE terms SET deleted_at = now(), version = version + 1
  WHERE user_id = '$OWNER' AND name = 'Spring term' AND deleted_at IS NULL RETURNING *
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now() WHERE EXISTS (SELECT 1 FROM gone)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, 'term', gone.id, 'upsert', to_jsonb(gone) - 'user_id' FROM gone, rev;
-- Term dates back to the seed (Flow 05 date edits).
WITH fixed AS (
  UPDATE terms t SET starts_on = v.s::date, ends_on = v.e::date, version = t.version + 1
  FROM (VALUES ('Fall term', '2026-09-14', '2026-12-11'), ('Exam weeks', '2026-12-12', '2026-12-22'),
               ('Winter term', '2027-01-05', '2027-04-16')) v(n, s, e)
  WHERE t.user_id = '$OWNER' AND t.name = v.n AND t.deleted_at IS NULL
    AND (t.starts_on <> v.s::date OR t.ends_on <> v.e::date) RETURNING t.*
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now() WHERE EXISTS (SELECT 1 FROM fixed)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, 'term', fixed.id, 'upsert', to_jsonb(fixed) - 'user_id' FROM fixed, rev;
-- Theme back to the seed's "follow the system" (Flow 03's offline proof toggles it), so light/dark captures
-- follow the Simulator's appearance.
WITH changed AS (
  UPDATE users SET theme = 'system', version = version + 1
  WHERE id = '$OWNER' AND theme <> 'system' RETURNING *
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now() WHERE EXISTS (SELECT 1 FROM changed)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, 'profile', changed.id, 'upsert',
  jsonb_build_object('display_name', changed.display_name, 'time_zone', changed.time_zone,
    'day_start_min', changed.day_start_min, 'day_end_min', changed.day_end_min,
    'quiet_start_min', changed.quiet_start_min, 'quiet_end_min', changed.quiet_end_min,
    'week_start', changed.week_start, 'theme', changed.theme, 'ai_mode', changed.ai_mode,
    'ai_provider', changed.ai_provider, 'profile_json', changed.profile_json, 'version', changed.version)
FROM changed, rev;
-- Flow 09 evidence (rename, recolour, merge, delete): the owner's seed categories, and the categories of seed
-- blocks and one-offs, back to the seed file's values.
CREATE TEMP TABLE seedcat (LIKE categories INCLUDING DEFAULTS) ON COMMIT DROP;
CREATE TEMP TABLE seedrb (LIKE routine_blocks INCLUDING DEFAULTS) ON COMMIT DROP;
CREATE TEMP TABLE seedov (LIKE overrides INCLUDING DEFAULTS) ON COMMIT DROP;
$(seed_rows categories seedcat)
$(seed_rows routine_blocks seedrb)
$(seed_rows overrides seedov)
WITH cats AS (
  UPDATE categories c SET name = s.name, group_name = s.group_name, color_dark = s.color_dark,
    color_light = s.color_light, quiet = s.quiet, deleted_at = NULL, version = c.version + 1
  FROM seedcat s WHERE c.id = s.id AND (c.name <> s.name OR c.group_name <> s.group_name
    OR c.color_dark <> s.color_dark OR c.color_light <> s.color_light OR c.quiet <> s.quiet OR c.deleted_at IS NOT NULL)
  RETURNING c.*
), rbs AS (
  UPDATE routine_blocks r SET category_id = s.category_id, version = r.version + 1
  FROM seedrb s WHERE r.id = s.id AND r.category_id <> s.category_id RETURNING r.*
), ovs AS (
  UPDATE overrides o SET category_id = s.category_id, version = o.version + 1
  FROM seedov s WHERE o.id = s.id AND o.category_id IS DISTINCT FROM s.category_id RETURNING o.*
), rev AS (
  INSERT INTO revisions(user_id, revision, updated_at) SELECT '$OWNER', 1, now()
  WHERE EXISTS (SELECT 1 FROM cats) OR EXISTS (SELECT 1 FROM rbs) OR EXISTS (SELECT 1 FROM ovs)
  ON CONFLICT (user_id) DO UPDATE SET revision = revisions.revision + 1, updated_at = now() RETURNING revision
)
INSERT INTO change_log(user_id, revision, entity, entity_id, op, row_json)
SELECT '$OWNER', rev.revision, x.entity, x.id, 'upsert', x.row FROM rev, (
  SELECT 'category' AS entity, id, to_jsonb(cats) - 'user_id' AS row FROM cats
  UNION ALL SELECT 'routine_block', id, to_jsonb(rbs) - 'user_id' FROM rbs
  UNION ALL SELECT 'override', id, to_jsonb(ovs) - 'user_id' FROM ovs) x;
-- Merges made by evidence runs can no longer be undone (their rows are back).
UPDATE category_merges SET undone_at = now() WHERE user_id = '$OWNER' AND undone_at IS NULL;
COMMIT;
SQL
log "Evidence test data removed (if any was there)."
